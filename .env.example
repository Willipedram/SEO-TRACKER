APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_TRUSTED_HOSTS=example.com
LOG_LEVEL=info
LOG_PATH=storage/logs/application.log
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seo_tracker
DB_USERNAME=seo_tracker
DB_PASSWORD=
DB_CHARSET=utf8mb4
SESSION_SECURE=true
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=43200
AUTH_IDLE_TIMEOUT=1800
AUTH_ABSOLUTE_TIMEOUT=43200
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW=900
AUTH_RESET_LIFETIME=3600
RANK_ADAPTER=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# Optional when APP_URL is correct; defaults to APP_URL/oauth/search-console/callback
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=
SEARCH_CONSOLE_ENCRYPTION_KEY=
SEARCH_CONSOLE_ENCRYPTION_KEY_VERSION=v1
